{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustyCord",
  "version": "0.4.0",
  "identifier": "dev.rustycord.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RustyCord",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking",
    "shortDescription": "Discord client on Rust + Tauri",
    "longDescription": "RustyCord — неофициальный клиент Discord на Rust + Tauri 2: Gateway-сокет с RESUME, REST с rate-limit-бакетами, голосовые каналы Voice v4 (UDP + xsalsa20poly1305) и пиксельная тема Discord на Svelte 5.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
